# Copy this file to .env and paste your keys. Never commit .env.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Daily cap on new cross-border traces in the public demo (cached traces are free and unlimited)
TRACE_DAILY_LIMIT=30
TRACE_PER_VISITOR_LIMIT=5

# Daily cap on Nemotron Nano column mapping for unfamiliar stock-file headers (whole site / per visitor)
COLUMNS_DAILY_LIMIT=200
COLUMNS_PER_VISITOR_LIMIT=20
